# =============================================
# Copy this file to .env and fill in real values.
#
#     cp env.example .env
#
# Check your work with:  python -m app.scripts.check_env
# That prints OK/MISSING per variable NAME and never prints a value, so its
# output is safe to paste anywhere.
#
# Startup FAILS if a required value is empty or still holds a placeholder.
# This file is documentation only — it is never read as a source of values.
# The prototype did read it, which is why a fake API key used to pass
# validation and the dashboard reported itself configured. See ISSUES.md B3.
#
# Save as UTF-8 WITHOUT a byte-order mark. Notepad's "UTF-8 with BOM" makes
# python-dotenv fail on line 1. In Notepad choose Save As -> Encoding "UTF-8",
# not "UTF-8 with BOM"; in VS Code the status bar should read "UTF-8".
# =============================================


# #############################################
# PART 1 — READ BY THE CODE TODAY
# #############################################

# =============================================
# REQUIRED — the app will not start without these
# =============================================

# --- LLM (Groq) --- https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Outbound mail --- use the business-domain mailbox, not a personal address
SMTP_EMAIL=
SMTP_PASSWORD=

# =============================================
# SENDING SAFETY — read this before changing it
# =============================================
# SEND_MODE decides whether mail can leave at all. There is no other switch,
# and it is enforced in exactly one function: email_utils.is_send_allowed().
#
#   disabled   (default) Nothing is sent, to anyone. Drafts are still generated
#              and saved, so the whole pipeline can be exercised safely.
#   allowlist  Sends ONLY to addresses in SEND_ALLOWLIST. Every other recipient
#              is recorded as SKIPPED_NOT_ALLOWLISTED and never contacted.
#   live       Sends to anyone. Set this only in production, deliberately.
SEND_MODE=disabled

# Comma-separated addresses allowed to receive mail when SEND_MODE=allowlist.
# Use your own mailboxes to rehearse. Matching ignores case and surrounding spaces.
# e.g. you@example.com,you+test@example.com
SEND_ALLOWLIST=

# NOTE: the old DRY_RUN_EMAILS flag has been REMOVED because it was dangerously
# misleading. This file used to say "leave unset or 0 to send real emails", but
# DRY_RUN_EMAILS=0 actually SUPPRESSED every send — the string "0" is truthy in
# Python — while still marking each lead EMAIL_SENT. Anyone following the
# documentation would believe a campaign had gone out when nothing did. Startup
# now fails if DRY_RUN_EMAILS is still set, so the mistake cannot pass unnoticed.

# =============================================
# SMTP transport
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Increase if you see "semaphore timeout" on Windows.
SMTP_TIMEOUT=90
# 1 for implicit TLS on port 465. Leave 0 for STARTTLS on port 587.
SMTP_USE_TLS=0
# Require STARTTLS on a plaintext port. Keep this on: turning it off would put
# your mailbox password on the wire in the clear. Only the test suite sets it 0.
SMTP_START_TLS=1

# =============================================
# Inbound mail (IMAP) — needed for reply monitoring
# =============================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=
IMAP_PASSWORD=

# =============================================
# Approvals
# =============================================
# cli = approve at the terminal. api = approve from the dashboard.
# The API server forces this to "api" at startup, since it has no stdin.
APPROVAL_MODE=cli

# 1 skips human review of insights and drafts. The API server REFUSES to start
# with this on, because nobody is watching a terminal there.
AUTO_APPROVE=0

# =============================================
# Workflow
# =============================================
# Your booking link, used as the call to action in drafts.
CALENDAR_LINK=
DB_PATH=leads.db
MAX_CONCURRENT_LEADS=5
REPLY_CHECK_INTERVAL_MINUTES=5
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# #############################################
# PART 2 — NOT READ BY ANY CODE YET
#
# These are the variables the target architecture needs. They are listed here
# so accounts and keys can be provisioned ahead of time, with the phase that
# starts using each. Setting one today does nothing: the settings class ignores
# unknown variables, so a value here cannot change current behaviour.
#
# Full provisioning instructions are in docs/SETUP_CHECKLIST.md.
# #############################################

# =============================================
# Database — Phase 1 (data layer, state machine, job queue)
# =============================================
# ADR-001: Postgres runs as a service in our own docker compose file, NOT on
# Supabase. That removes the IPv4/session-pooler workaround, the 500 MB free
# ceiling, the auto-generated Data API, and the RLS deny-all second lock.
#
# PORT 5433, NEVER 5432 (ADR-005). The default Postgres port is very likely
# already taken by another project's container on your machine, and a wrong
# password is a terrible last line of defence against migrating the wrong
# database. Migrations now refuse to run unless the target database is named
# `outreach` and contains no tables that are not ours.
#
# Start it with --env-file, or POSTGRES_PASSWORD below is silently ignored
# (compose resolves a bare .env next to the compose file, not here):
#   docker compose --env-file .env -f deploy/compose.yml up -d
#
# POSTGRES_PASSWORD only applies when the volume is first created. To change it
# afterwards you must `down -v`, which destroys the data.
DATABASE_URL=postgresql+asyncpg://outreach:CHANGE_ME@127.0.0.1:5433/outreach
POSTGRES_USER=outreach
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=outreach

# =============================================
# Auth — Phase 7 (Supabase is used for AUTHENTICATION ONLY)
# =============================================
# Create a Supabase project, but use only its Auth product. We never store
# application data there, so there is no Supabase database URL below.
# The API verifies the JWT locally against the project's JWKS; the anon key is
# public by design and is used by the browser, not the server.
# In the Supabase dashboard: disable public sign-ups, and turn the Data API OFF.
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Comma-separated browser origins allowed to call the API (replaces CORS "*").
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================
# LLM router — Phase 3 (free-first, multi-provider)
# =============================================
# LLM_CHAIN is an ordered JSON list of provider entries. The router walks it and
# uses the first healthy entry with headroom, cooling down any entry that returns
# 429 or a quota error. Entries whose api_key_env is unset are skipped, so adding
# a provider is just a matter of setting its key.
#
# One account per provider — never register extra accounts to dodge a free quota.
# Extra headroom comes from more models and more providers.
#
# allow_pii=false marks providers that may train on prompts. Those receive public
# website text only: never a lead's name, email address or reply text.
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=                 # Google AI Studio: allow_pii=false outside the EEA/UK
# Paid fallback stays off unless both of these are set deliberately.
# PAID_LLM_ENABLED=false
# PAID_LLM_DAILY_USD_CAP=

# =============================================
# Research — Phase 3 (web search, optional)
# =============================================
# Tavily free tier is 1,000 credits/month; a basic search costs 1. At most one
# search per lead, only when the company's own site yields thin evidence.
# Without a key the research engine degrades gracefully to site text only.
# TAVILY_API_KEY=
# TAVILY_MONTHLY_CREDIT_BUDGET=1000

# =============================================
# Worker and operations — Phases 5, 6 and 9
# =============================================
# Shared secret for POST /internal/tick, which runs one scheduler cycle.
# INTERNAL_TICK_SECRET=
# Optional: where alerts go (SMTP auth failure, LLM chain exhausted, dead jobs,
# bounce-rate spike). Without it, alerts are only visible in the dashboard.
# ALERT_WEBHOOK_URL=
# Set only if your mail provider does NOT copy SMTP-sent mail to the Sent folder,
# so a crashed send can still be found by Message-ID (ADR-002).
# BCC_SELF=false

# =============================================
# Frontend — Phase 8 (Cloudflare Workers hosting)
# =============================================
# These live in the frontend build environment, not in this file. Cloudflare
# needs no secret here — it builds from the repo. Set these as build variables:
#   VITE_API_URL=https://api.<your-domain>
#   VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<the public anon key>

# Which deployment this is: development | staging | production. Production hides /docs.
APP_ENV=development

# =============================================
# Deployment — Phase 9 (the VM only; see docs/DEPLOY.md)
# =============================================
# Read by deploy/compose.prod.yml and deploy/Caddyfile, not by the application.
# None of them are secret, and all of them are required on the server.
#
# The hostname Caddy obtains a TLS certificate for. DNS must already point at the
# VM before the first start: Let's Encrypt resolves this name and connects back on
# port 80, and failures there count against an hourly rate limit.
# API_DOMAIN=api.your-domain.com
#
# A real address. Where Let's Encrypt sends expiry and failure notices.
# ACME_EMAIL=you@your-domain.com
#
# The dashboard's origin, for the Caddy log and for reference. CORS itself is
# enforced by the application through CORS_ALLOWED_ORIGINS above — setting it in
# both places is how you get two conflicting Access-Control-Allow-Origin headers.
# DASHBOARD_ORIGIN=https://outreach-automation.<subdomain>.workers.dev
#
# Which addresses' X-Forwarded-For the api may trust: the Docker network Caddy is
# on, never "*". Without it every caller looks like Caddy and the address-keyed
# rate limit becomes one shared bucket.
# FORWARDED_ALLOW_IPS=172.16.0.0/12
#
# Set by deploy.sh to the short commit sha, so a rollback can name the previous
# image. Leave it unset for a local build.
# IMAGE_TAG=local
#
# NOTE: DATABASE_URL above is IGNORED on the server. compose.prod.yml overrides it
# to reach postgres:5432 on the Compose network, so the same file shape works on a
# developer machine (127.0.0.1:5433) and on the VM.

# =============================================================================
# Multi-user: who may sign up, and how their mailbox authenticates (ADR-017/018)
# =============================================================================
#
# closed (default) = only members somebody inserted deliberately, which is the
# behaviour this project had before these settings existed. allowlist = anybody
# at a domain below. open = anybody who can sign in to Supabase.
#
# `open` means a stranger can create a workspace and send cold email through
# software you host. They send as themselves, with their own Gmail quota and
# their own reputation — this is not an open relay, and nobody can send as
# anybody else. It is still a decision rather than a default.
# SIGNUP_MODE=closed
# SIGNUP_ALLOWED_DOMAINS=arkvane.in,someclient.com
#
# A ceiling on workspaces. One small instance and one shared free LLM tier: the
# failure mode of open sign-up is strangers quietly exhausting that tier until
# the people who actually use the tool get nothing.
# MAX_ORGS=25
#
# Encrypts stored mailbox credentials. Generate with:
#   python -m app.scripts.make_key
# Without it, connecting a mailbox is refused rather than stored in the clear —
# a refresh token in plain text in a database that is dumped nightly to S3 is a
# Gmail account in a backup. Losing it means every mailbox reconnects.
# CREDENTIAL_KEY=
#
# The OAuth client from docs/OWNER_SETUP.md §1. All three or none: a client id
# with no secret fails at the callback, which is the least debuggable moment.
# The redirect URI must match the Cloud console exactly, with no trailing slash.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.arkvane.in/api/v1/connect/google/callback
#
# How many days a refresh token from this client survives. SEVEN for a client in
# Testing status, which is where ADR-018 deliberately leaves it: publishing one
# that asks for a restricted scope needs an annual paid security assessment.
# So every connected mailbox is reconnected weekly, the dashboard counts down to
# it, and the worker warns one day before and on the day. Set 0 the day the
# client is published and all of that stops, with no code change.
# GOOGLE_GRANT_DAYS=7
#
# Where to send the browser after an OAuth round trip. Its own setting rather
# than "the first CORS origin", because a redirect target chosen by position in
# a list is one somebody reorders by accident.
# DASHBOARD_URL=https://outreach-automation.<subdomain>.workers.dev
