# Environment
# `.env.*` matters as much as `.env`: a deploy makes timestamped backups like `.env.bak.17…`,
# and those hold every secret the live file does. Without this line they show up as untracked,
# which both risks committing them and makes `deploy.sh` refuse to run on a "dirty" tree.
# `env.example` is undotted on purpose and is therefore unaffected.
.env
.env.*
.venv/
.venv311/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Database
*.db
leads.db

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log

# Uploads and local-only data (real lead sheets, never committed)
uploads/
local/

# Database dumps. Every one of these is a full copy of every lead, every email body and every
# reply, so a dump committed by accident is the worst single file this repository could hold.
backups/
*.sql
*.sql.gz
*.dump

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
frontend/dist/
npm-debug.log*
