// Cloudflare configuration for the dashboard (ARCHITECTURE_TARGET.md §3).
//
// This is an assets-only Worker: no server code, just the Vite build output. The API lives on the
// VM behind Caddy, so nothing here talks to the database or SMTP.
//
// `not_found_handling` is what makes a refresh on /leads/123 work. Without it, Cloudflare looks for
// a file at that path, does not find one, and returns 404 — the router never gets a chance to run,
// because the router is in the JavaScript that was never served. "single-page-application" serves
// index.html with a 200 instead, which is the behaviour a client-side router needs.
//
// If the dashboard project was created as **Pages** rather than a Worker, delete the `assets` block
// and use `"pages_build_output_dir": "./dist"` instead — see docs/SETUP_CHECKLIST.md §7.
{
  "name": "outreach-automation",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
