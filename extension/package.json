{
  "name": "outreach-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Chrome side panel that suggests answers to job-application questions. It never fills or submits anything.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.26",
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
